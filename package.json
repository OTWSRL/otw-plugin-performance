{
  "name": "@otwdesign/plugin-performance",
  "version": "1.0.0",
  "private": true,
  "description": "How long each request takes on the server and in the browser: queries, hooks, plugins and Web Vitals.",
  "type": "module",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.tsx",
    "./prerendered": "./src/prerendered.tsx",
    "./admin": "./src/admin.tsx"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "dev": "pnpm --filter ./site dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p . && pnpm --filter ./site typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter ./site test:e2e",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "peerDependencies": {
    "@otwdesign/admin-ui": "^1.0.0",
    "@otwdesign/sdk": "^1.0.0",
    "next": "^16.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@otwdesign/admin-ui": "link:../nextjs-cms/packages/admin-ui",
    "@otwdesign/sdk": "link:../nextjs-cms/packages/sdk",
    "@otwdesign/testing": "link:../nextjs-cms/packages/testing",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "next": "^16.4.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
